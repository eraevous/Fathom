periods_are_distinguished_from_explicit_zeros"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_event_counts_from_timestamps_with_hour_and_day"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_by_split_limits_to_top_n_groups"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_pacf_durbin_levinson_on_ar1_acf"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_spectral_degrades_without_scipy"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_report_has_temporal_section_with_stem_plots"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_undeclared_series_asks_one_question"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_undeclared_pure_timestamps_offer_event_counts"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_undeclared_question_quiet_on_few_periods_and_skips_identifier_like"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_inter_event_interval_does_not_span_missing_periods"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_zero_and_burst_signals_need_thirty_periods"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_decoys_stay_silent"}, {"rel": "observed_on", "to": "code:tests.test_time_series.test_invalid_declarations_are_refused"}]}
